{
  "name": "spotify-ipod-electron",
  "version": "1.0.0",
  "description": "A nostalgic iPod-inspired Spotify player built with Electron and React",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev-client\" \"npm:dev-electron\"",
    "dev-client": "npm run dev --prefix client",
    "dev-electron": "wait-on http://localhost:5173 && electron .",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "spotify",
    "ipod",
    "music",
    "player"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "querystring": "^0.2.1"
  }
}
